# Copy to .claude/pi.local.env (git-ignored, never pushed) and fill in.
# Read by the /pi-setup, /pi-deploy and /pi-diagnose skills when no host is given.
# NEVER put a password here: SSH works with a key (ssh-copy-id), install.sh asks for sudo itself.
PI_USER=ton-utilisateur      # the user created in Raspberry Pi Imager
PI_IP=192.168.1.x            # for the first install (/pi-setup): see your router's interface
PI_HOST=easytv.local         # once installed (install.sh renames the Pi easytv)
